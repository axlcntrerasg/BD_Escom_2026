--Cancela las citas que no se pagaron dentro de las 8 horas (libera el horario)
--La llaman sp_AgendarCita y sp_PagarCita antes de trabajar; Flask tambien puede llamarla al iniciar sesion
CREATE PROCEDURE sp_CancelarFaltaPago
AS
BEGIN
SET NOCOUNT ON;
BEGIN TRANSACTION;
--Primero se registra la cancelacion (el trigger de la bitacora la necesita)
INSERT INTO CANCELACION (folio_cita, solicitada_por, motivo, estado, porcentaje_devolucion, monto_devuelto)
SELECT folio_cita, 'Sistema', 'No se pagó en 8 horas', 'Aprobada', 0, 0
FROM CITA
WHERE estatus = 'Agendada pendiente de pago'
AND GETDATE() > DATEADD(HOUR, 8, fecha_registro);
--Despues se cambia el estatus de la cita
UPDATE CITA
SET estatus = 'Cancelada falta de pago'
WHERE estatus = 'Agendada pendiente de pago'
AND GETDATE() > DATEADD(HOUR, 8, fecha_registro);
COMMIT TRANSACTION;
END
GO

--Agendar cita: valida todas las reglas del PDF y regresa el comprobante
CREATE PROCEDURE sp_AgendarCita
@id_paciente INT,
@num_doctor INT,
@fecha DATE,
@hora TIME
AS
BEGIN
SET NOCOUNT ON;
--Libera los horarios de citas que ya vencieron sin pago
EXEC sp_CancelarFaltaPago;

DECLARE @fecha_hora DATETIME = CAST(@fecha AS DATETIME) + CAST(@hora AS DATETIME);
DECLARE @entrada TIME, @salida TIME, @id_consultorio INT, @costo DECIMAL(10,2);

--El paciente debe existir
IF NOT EXISTS (SELECT 1 FROM PACIENTE WHERE id_paciente = @id_paciente)
BEGIN
RAISERROR('El paciente no existe.', 16, 1);
RETURN;
END
--El doctor debe existir y estar activo; de aqui se toman su jornada, consultorio y costo
SELECT @entrada = d.hora_entrada, @salida = d.hora_salida, @id_consultorio = d.id_consultorio, @costo = es.costo_consulta
FROM DOCTOR d
JOIN EMPLEADO e ON e.num_empleado = d.num_empleado
JOIN ESPECIALIDAD es ON es.id_especialidad = d.id_especialidad
WHERE d.num_empleado = @num_doctor AND e.activo = 1;
IF @costo IS NULL
BEGIN
RAISERROR('El doctor no existe o no está activo.', 16, 1);
RETURN;
END
--Las citas son en bloques de 30 minutos
IF DATEPART(MINUTE, @hora) NOT IN (0, 30)
BEGIN
RAISERROR('La hora debe ser en punto o y media (bloques de 30 minutos).', 16, 1);
RETURN;
END
--No se puede agendar en el pasado
IF @fecha_hora < GETDATE()
BEGIN
RAISERROR('La fecha de la cita ya pasó.', 16, 1);
RETURN;
END
--Minimo 48 horas de anticipacion
IF @fecha_hora < DATEADD(HOUR, 48, GETDATE())
BEGIN
RAISERROR('La cita debe agendarse con al menos 48 horas de anticipación.', 16, 1);
RETURN;
END
--Maximo 3 meses de anticipacion
IF @fecha > DATEADD(MONTH, 3, CAST(GETDATE() AS DATE))
BEGIN
RAISERROR('La cita no puede ser con más de 3 meses de anticipación.', 16, 1);
RETURN;
END
--Debe estar dentro de la jornada del doctor (la cita dura 30 minutos)
IF @hora < @entrada OR DATEADD(MINUTE, 30, @hora) > @salida
BEGIN
RAISERROR('La hora está fuera del horario de trabajo del doctor.', 16, 1);
RETURN;
END
--El doctor no debe tener otra cita a esa hora
IF EXISTS (SELECT 1 FROM CITA
WHERE num_empleado_doctor = @num_doctor AND fecha_cita = @fecha AND hora_cita = @hora
AND estatus IN ('Agendada pendiente de pago', 'Pagada pendiente por atender'))
BEGIN
RAISERROR('El doctor ya tiene una cita en ese horario.', 16, 1);
RETURN;
END
--El paciente no debe tener otra cita a esa hora
IF EXISTS (SELECT 1 FROM CITA
WHERE id_paciente = @id_paciente AND fecha_cita = @fecha AND hora_cita = @hora
AND estatus IN ('Agendada pendiente de pago', 'Pagada pendiente por atender'))
BEGIN
RAISERROR('Ya tienes otra cita en ese horario.', 16, 1);
RETURN;
END
--El paciente no debe tener una cita pendiente con el mismo doctor
IF EXISTS (SELECT 1 FROM CITA
WHERE id_paciente = @id_paciente AND num_empleado_doctor = @num_doctor
AND estatus IN ('Agendada pendiente de pago', 'Pagada pendiente por atender'))
BEGIN
RAISERROR('Ya tienes una cita pendiente con este doctor.', 16, 1);
RETURN;
END
--Linea de pago unica: LP + fecha y hora actuales + id del paciente (20 caracteres)
DECLARE @linea VARCHAR(20) = 'LP'
+ CONVERT(VARCHAR(8), GETDATE(), 112)
+ REPLACE(CONVERT(VARCHAR(8), GETDATE(), 108), ':', '')
+ RIGHT('0000' + CAST(@id_paciente AS VARCHAR(10)), 4);
--Se guarda la cita (el trigger la registra en la bitacora)
INSERT INTO CITA (id_paciente, num_empleado_doctor, id_consultorio, fecha_cita, hora_cita, costo, linea_pago)
VALUES (@id_paciente, @num_doctor, @id_consultorio, @fecha, @hora, @costo, @linea);
--Regresa el comprobante
SELECT * FROM V_COMPROBANTE_CITA WHERE folio_cita = SCOPE_IDENTITY();
END
GO

--Pagar cita: el trigger TR_PAGO_VALIDAR revisa estatus, monto y las 8 horas, y cambia la cita a Pagada
CREATE PROCEDURE sp_PagarCita
@folio_cita INT,
@metodo_pago VARCHAR(15)
AS
BEGIN
SET NOCOUNT ON;
EXEC sp_CancelarFaltaPago;
IF NOT EXISTS (SELECT 1 FROM CITA WHERE folio_cita = @folio_cita)
BEGIN
RAISERROR('La cita no existe.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM CITA WHERE folio_cita = @folio_cita AND estatus = 'Cancelada falta de pago')
BEGIN
RAISERROR('La cita se canceló porque no se pagó dentro de las 8 horas.', 16, 1);
RETURN;
END
--El monto es el costo guardado en la cita
INSERT INTO PAGO (folio_cita, monto, metodo_pago)
SELECT folio_cita, costo, @metodo_pago
FROM CITA
WHERE folio_cita = @folio_cita;
END
GO

--El paciente cancela su cita: aplica la politica 100% / 50% / 0%
CREATE PROCEDURE sp_CancelarCitaPaciente
@folio_cita INT,
@id_paciente INT,
@motivo VARCHAR(250)
AS
BEGIN
SET NOCOUNT ON;
DECLARE @estatus VARCHAR(30), @costo DECIMAL(10,2), @fecha_hora DATETIME;
SELECT @estatus = estatus, @costo = costo, @fecha_hora = CAST(fecha_cita AS DATETIME) + CAST(hora_cita AS DATETIME)
FROM CITA
WHERE folio_cita = @folio_cita AND id_paciente = @id_paciente;
IF @estatus IS NULL
BEGIN
RAISERROR('La cita no existe o no es tuya.', 16, 1);
RETURN;
END
IF @estatus NOT IN ('Agendada pendiente de pago', 'Pagada pendiente por atender')
BEGIN
RAISERROR('Esta cita ya no se puede cancelar.', 16, 1);
RETURN;
END
IF @fecha_hora <= GETDATE()
BEGIN
RAISERROR('La cita ya empezó o ya pasó, no se puede cancelar.', 16, 1);
RETURN;
END
--Minutos que faltan para la cita: 48 h = 2880 min, 24 h = 1440 min
DECLARE @minutos INT = DATEDIFF(MINUTE, GETDATE(), @fecha_hora);
DECLARE @porcentaje INT;
IF @estatus = 'Agendada pendiente de pago'
SET @porcentaje = 0; --no hay pago que devolver
ELSE IF @minutos >= 2880
SET @porcentaje = 100;
ELSE IF @minutos >= 1440
SET @porcentaje = 50;
ELSE
SET @porcentaje = 0;
DECLARE @monto DECIMAL(10,2) = @costo * @porcentaje / 100;
BEGIN TRY
BEGIN TRANSACTION;
INSERT INTO CANCELACION (folio_cita, solicitada_por, motivo, estado, porcentaje_devolucion, monto_devuelto)
VALUES (@folio_cita, 'Paciente', @motivo, 'Aprobada', @porcentaje, @monto);
UPDATE CITA SET estatus = 'Cancelada paciente' WHERE folio_cita = @folio_cita;
COMMIT TRANSACTION;
SELECT @porcentaje AS porcentaje_devolucion, @monto AS monto_devuelto;
END TRY
BEGIN CATCH
IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
DECLARE @msg VARCHAR(400) = ERROR_MESSAGE();
RAISERROR(@msg, 16, 1);
END CATCH
END
GO

