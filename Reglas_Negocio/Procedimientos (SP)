--El doctor solicita cancelar una cita; queda Pendiente hasta que recepcion la apruebe
CREATE PROCEDURE sp_SolicitarCancelacionDoctor
@folio_cita INT,
@num_doctor INT,
@motivo VARCHAR(250)
AS
BEGIN
SET NOCOUNT ON;
IF NOT EXISTS (SELECT 1 FROM CITA
WHERE folio_cita = @folio_cita AND num_empleado_doctor = @num_doctor
