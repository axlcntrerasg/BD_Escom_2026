--Crea el ticket; despues se agregan los renglones
CREATE PROCEDURE sp_CrearVenta
@num_empleado INT,
@id_paciente INT = NULL,
@nombre_cliente VARCHAR(120) = NULL,
@metodo_pago VARCHAR(15)
AS
BEGIN
SET NOCOUNT ON;
INSERT INTO VENTA (num_empleado, id_paciente, nombre_cliente, metodo_pago)
VALUES (@num_empleado, @id_paciente, @nombre_cliente, @metodo_pago);
SELECT SCOPE_IDENTITY() AS id_venta;
END
GO

--Agrega un medicamento al ticket con su precio actual (el trigger valida y descuenta el stock)
CREATE PROCEDURE sp_AgregarMedicamentoVenta
@id_venta INT,
@id_medicamento INT,
@cantidad INT
AS
BEGIN
SET NOCOUNT ON;
INSERT INTO DETALLE_VENTA (id_venta, id_medicamento, cantidad, precio_unitario)
SELECT @id_venta, id_medicamento, @cantidad, precio
FROM MEDICAMENTO
WHERE id_medicamento = @id_medicamento;
IF @@ROWCOUNT = 0
RAISERROR('El medicamento no existe.', 16, 1);
END
