--RECEPCIONISTA

--Alta de recepcionista, farmaceutico o doctor junto con su usuario
--Solo la puede hacer un usuario Recepcionista o Admin
--Para Recepcionista y Farmaceutico los datos de doctor se mandan en NULL

CREATE PROCEDURE sp_AltaEmpleado
@alta_por INT,
@rol VARCHAR(15),
@username VARCHAR(50),
@contrasena VARCHAR(50),
@nombre VARCHAR(60),
@ap_paterno VARCHAR(60),
@ap_materno VARCHAR(60),
@curp CHAR(18),
@telefono CHAR(10),
@correo VARCHAR(100),
@cedula VARCHAR(8) = NULL,
@id_especialidad INT = NULL,
@id_consultorio INT = NULL,
@hora_entrada TIME = NULL,
@hora_salida TIME = NULL
AS
BEGIN
SET NOCOUNT ON;
IF NOT EXISTS (SELECT 1 FROM USUARIO WHERE id_usuario = @alta_por AND rol IN ('Recepcionista', 'Admin') AND activo = 1)
BEGIN
RAISERROR('Solo una recepcionista o el administrador pueden dar de alta empleados.', 16, 1);
RETURN;
END
IF @rol NOT IN ('Recepcionista', 'Farmaceutico', 'Doctor')
BEGIN
RAISERROR('El rol debe ser Recepcionista, Farmaceutico o Doctor.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM USUARIO WHERE username = @username)
BEGIN
RAISERROR('El nombre de usuario ya existe.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM EMPLEADO WHERE curp = @curp)
BEGIN
RAISERROR('Ya existe un empleado con esa CURP.', 16, 1);
RETURN;
END
IF @rol = 'Doctor'
BEGIN
IF @cedula IS NULL OR @id_especialidad IS NULL OR @id_consultorio IS NULL OR @hora_entrada IS NULL OR @hora_salida IS NULL
BEGIN
RAISERROR('Para un doctor se necesitan cédula, especialidad, consultorio y horario.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM DOCTOR WHERE cedula_profesional = @cedula)
BEGIN
RAISERROR('Ya existe un doctor con esa cédula profesional.', 16, 1);
RETURN;
END
--El consultorio no puede estar ocupado por otro doctor activo en un horario que se empalme
IF EXISTS (SELECT 1 FROM DOCTOR d JOIN EMPLEADO e ON e.num_empleado = d.num_empleado
WHERE d.id_consultorio = @id_consultorio AND e.activo = 1
AND d.hora_entrada < @hora_salida AND @hora_entrada < d.hora_salida)
BEGIN
RAISERROR('El consultorio ya está ocupado en ese horario por otro doctor.', 16, 1);
RETURN;
END
END
BEGIN TRY
BEGIN TRANSACTION;
INSERT INTO USUARIO (username, contrasena, rol) VALUES (@username, @contrasena, @rol);
DECLARE @id_usuario INT = SCOPE_IDENTITY();
INSERT INTO EMPLEADO (id_usuario, nombre, ap_paterno, ap_materno, curp, telefono, correo)
VALUES (@id_usuario, @nombre, @ap_paterno, @ap_materno, @curp, @telefono, @correo);
DECLARE @num_empleado INT = SCOPE_IDENTITY();
IF @rol = 'Doctor'
INSERT INTO DOCTOR (num_empleado, cedula_profesional, id_especialidad, id_consultorio, hora_entrada, hora_salida)
VALUES (@num_empleado, @cedula, @id_especialidad, @id_consultorio, @hora_entrada, @hora_salida);
COMMIT TRANSACTION;
SELECT @num_empleado AS num_empleado;
END TRY
BEGIN CATCH
IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
DECLARE @msg VARCHAR(400) = ERROR_MESSAGE();
RAISERROR(@msg, 16, 1);
END CATCH
END
GO

--La recepcionista modifica los datos sensibles de un doctor
--La especialidad solo se puede cambiar si el doctor no tiene citas pendientes
CREATE PROCEDURE sp_ActualizarDoctor
@num_doctor INT,
@nombre VARCHAR(60),
@ap_paterno VARCHAR(60),
@ap_materno VARCHAR(60),
@curp CHAR(18),
@cedula VARCHAR(8),
@id_especialidad INT
AS
BEGIN
SET NOCOUNT ON;
IF EXISTS (SELECT 1 FROM DOCTOR WHERE num_empleado = @num_doctor AND id_especialidad <> @id_especialidad)
AND EXISTS (SELECT 1 FROM CITA WHERE num_empleado_doctor = @num_doctor
AND estatus IN ('Agendada pendiente de pago', 'Pagada pendiente por atender'))
BEGIN
RAISERROR('No se puede cambiar la especialidad: el doctor tiene citas pendientes.', 16, 1);
RETURN;
END
BEGIN TRY
BEGIN TRANSACTION;
UPDATE EMPLEADO SET nombre = @nombre, ap_paterno = @ap_paterno, ap_materno = @ap_materno, curp = @curp
WHERE num_empleado = @num_doctor;
UPDATE DOCTOR SET cedula_profesional = @cedula, id_especialidad = @id_especialidad
WHERE num_empleado = @num_doctor;
COMMIT TRANSACTION;
END TRY
BEGIN CATCH
IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
DECLARE @msg VARCHAR(400) = ERROR_MESSAGE();
RAISERROR(@msg, 16, 1);
END CATCH
END
GO

--Baja logica de un empleado (no se borra); un doctor con citas pendientes no se puede dar de baja
CREATE PROCEDURE sp_BajaEmpleado
@num_empleado INT
AS
BEGIN
SET NOCOUNT ON;
IF EXISTS (SELECT 1 FROM CITA WHERE num_empleado_doctor = @num_empleado
AND estatus IN ('Agendada pendiente de pago', 'Pagada pendiente por atender'))
BEGIN
RAISERROR('El doctor tiene citas pendientes; cancélalas o reasígnalas antes de darlo de baja.', 16, 1);
RETURN;
END
UPDATE EMPLEADO SET activo = 0 WHERE num_empleado = @num_empleado;
UPDATE USUARIO SET activo = 0 WHERE id_usuario = (SELECT id_usuario FROM EMPLEADO WHERE num_empleado = @num_empleado);
END
GO

--La recepcionista aprueba o rechaza la solicitud de cancelacion de un doctor
--Si la aprueba y la cita estaba pagada, se devuelve el 100%
CREATE PROCEDURE sp_ResolverCancelacion
@id_cancelacion INT,
@num_recepcionista INT,
@aprobar BIT
AS
BEGIN
SET NOCOUNT ON;
DECLARE @folio INT, @estatus VARCHAR(30), @costo DECIMAL(10,2);
IF NOT EXISTS (SELECT 1 FROM EMPLEADO e JOIN USUARIO u ON u.id_usuario = e.id_usuario
WHERE e.num_empleado = @num_recepcionista AND u.rol = 'Recepcionista')
BEGIN
RAISERROR('Solo una recepcionista puede resolver solicitudes de cancelación.', 16, 1);
RETURN;
END
SELECT @folio = ca.folio_cita, @estatus = c.estatus, @costo = c.costo
FROM CANCELACION ca
JOIN CITA c ON c.folio_cita = ca.folio_cita
WHERE ca.id_cancelacion = @id_cancelacion AND ca.solicitada_por = 'Doctor' AND ca.estado = 'Pendiente';
IF @folio IS NULL
BEGIN
RAISERROR('La solicitud no existe o ya fue resuelta.', 16, 1);
RETURN;
END
--Rechazar: solo cambia el estado de la solicitud, la cita sigue igual
IF @aprobar = 0
BEGIN
UPDATE CANCELACION SET estado = 'Rechazada', aprobada_por = @num_recepcionista
WHERE id_cancelacion = @id_cancelacion;
RETURN;
END
IF @estatus NOT IN ('Agendada pendiente de pago', 'Pagada pendiente por atender')
BEGIN
RAISERROR('La cita ya no se puede cancelar.', 16, 1);
RETURN;
END
DECLARE @porcentaje INT = CASE WHEN @estatus = 'Pagada pendiente por atender' THEN 100 ELSE 0 END;
BEGIN TRY
BEGIN TRANSACTION;
UPDATE CANCELACION
SET estado = 'Aprobada', aprobada_por = @num_recepcionista, porcentaje_devolucion = @porcentaje, monto_devuelto = @costo * @porcentaje / 100
WHERE id_cancelacion = @id_cancelacion;
UPDATE CITA SET estatus = 'Cancelada doctor' WHERE folio_cita = @folio;
COMMIT TRANSACTION;
END TRY
BEGIN CATCH
IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
DECLARE @msg VARCHAR(400) = ERROR_MESSAGE();
RAISERROR(@msg, 16, 1);
END CATCH
END
GO

--Marca una cita pagada como No acudio (solo despues de la hora de la cita)
CREATE PROCEDURE sp_MarcarNoAcudio
@folio_cita INT
AS
BEGIN
SET NOCOUNT ON;
IF NOT EXISTS (SELECT 1 FROM CITA
WHERE folio_cita = @folio_cita AND estatus = 'Pagada pendiente por atender'
AND CAST(fecha_cita AS DATETIME) + CAST(hora_cita AS DATETIME) < GETDATE())
BEGIN
RAISERROR('Solo se puede marcar No acudió en una cita pagada cuya hora ya pasó.', 16, 1);
RETURN;
END
UPDATE CITA SET estatus = 'No acudio' WHERE folio_cita = @folio_cita;
END
GO

