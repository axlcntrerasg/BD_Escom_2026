--LOGIN Y REGISTRO


--Inicio de sesion: regresa el id, el rol y el id de paciente o de empleado
CREATE PROCEDURE sp_Login
@username VARCHAR(50),
@contrasena VARCHAR(50)
AS
BEGIN
SET NOCOUNT ON;
IF NOT EXISTS (SELECT 1 FROM USUARIO WHERE username = @username AND contrasena = @contrasena)
BEGIN
RAISERROR('Usuario o contraseña incorrectos.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM USUARIO WHERE username = @username AND activo = 0)
BEGIN
RAISERROR('La cuenta está desactivada.', 16, 1);
RETURN;
END
SELECT u.id_usuario,
u.username,
u.rol,
p.id_paciente,
e.num_empleado
FROM USUARIO u
LEFT JOIN PACIENTE p ON p.id_usuario = u.id_usuario
LEFT JOIN EMPLEADO e ON e.id_usuario = u.id_usuario
WHERE u.username = @username;
END
GO

--Registro de un paciente nuevo desde la web: crea su usuario y sus datos en una sola transaccion
CREATE PROCEDURE sp_RegistrarPaciente
@username VARCHAR(50),
@contrasena VARCHAR(50),
@nombre VARCHAR(60),
@ap_paterno VARCHAR(60),
@ap_materno VARCHAR(60),
@curp CHAR(18),
@fecha_nacimiento DATE,
@sexo CHAR(1),
@telefono CHAR(10),
@correo VARCHAR(100)
AS
BEGIN
SET NOCOUNT ON;
IF EXISTS (SELECT 1 FROM USUARIO WHERE username = @username)
BEGIN
RAISERROR('El nombre de usuario ya existe, elige otro.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM PACIENTE WHERE curp = @curp)
BEGIN
RAISERROR('Ya existe un paciente registrado con esa CURP.', 16, 1);
RETURN;
END
IF EXISTS (SELECT 1 FROM PACIENTE WHERE correo = @correo)
BEGIN
RAISERROR('Ya existe un paciente registrado con ese correo.', 16, 1);
RETURN;
END
IF @fecha_nacimiento > CAST(GETDATE() AS DATE)
BEGIN
RAISERROR('La fecha de nacimiento no puede ser futura.', 16, 1);
RETURN;
END
BEGIN TRY
BEGIN TRANSACTION;
INSERT INTO USUARIO (username, contrasena, rol)
VALUES (@username, @contrasena, 'Paciente');
DECLARE @id_usuario INT = SCOPE_IDENTITY();
INSERT INTO PACIENTE (id_usuario, nombre, ap_paterno, ap_materno, curp, fecha_nacimiento, sexo, telefono, correo)
VALUES (@id_usuario, @nombre, @ap_paterno, @ap_materno, @curp, @fecha_nacimiento, @sexo, @telefono, @correo);
COMMIT TRANSACTION;
SELECT SCOPE_IDENTITY() AS id_paciente;
END TRY
BEGIN CATCH
IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
DECLARE @msg VARCHAR(400) = ERROR_MESSAGE();
RAISERROR(@msg, 16, 1);
END CATCH
END
GO


